{
  "name": "obix-runtime-dom",
  "version": "0.5.0",
  "description": "The DOM of OBIX's native runtime: the rules by which a value of the canonical IR becomes an attribute and becomes text, and the host operations the runtime builds and updates a page with — HTML's rules, no framework's. Phase 6 (docs/recovery/native-runtime.md).",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-runtime-reactivity": "0.5.0"
  },
  "keywords": [
    "obix",
    "runtime",
    "dom",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-runtime-dom.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-runtime-dom/issues"
  },
  "homepage": "https://github.com/obinexus/obix-runtime-dom#readme"
}
